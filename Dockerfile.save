-alpine AS builder
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Bygg webservern
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o app ./cmd/api

FROM alpine:3.20
WORKDIR /app

COPY --from=builder /src/app /app/app
COPY --from=builder /src/web /app/web

EXPOSE 8080
CMD ["/app/app"]
